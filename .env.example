# Application settings
APP_NAME="Digital Process Engineer"
APP_VERSION=1.0.0
DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://draw_chat:draw_chat_dev@localhost:5432/draw_chat

# Authentication
SECRET_KEY=dev-secret-change-me
TOKEN_TTL_DAYS=7

# Bootstrap admin
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

# AI / LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet
AI_VERIFY_SSL=true

# File upload (bytes, default 20MB)
MAX_UPLOAD_BYTES=20971520

# Sentry
SENTRY_DSN=

# LLM
LLM_PAYLOAD_RETENTION_DAYS=0
LLM_HISTORY_MAX_CHARS=200000

# DXF Converter
DXF_CONVERTER_URL=http://dxf-converter:8001
DXF_CONVERTER_TIMEOUT=8.0

# OpenTelemetry (local example for Jaeger OTLP HTTP :4318)
OTEL_SERVICE_NAME=fastapi-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=always_on
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
